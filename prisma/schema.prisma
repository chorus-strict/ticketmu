// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  title      String
  message    String
  link       String?
  roleTarget Role             @default(USER)
  type       NotificationType @default(SYSTEM)
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId])
}

enum NotificationType {
  ORDER
  PAYMENT
  SYSTEM
}

enum Role {
  USER
  ADMIN
}

enum Membership {
  FREE
  PENDING
  PREMIUM
}

model MembershipOrder {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  amount          Float
  discountAmount  Float          @default(0)
  userRewardId    String?
  userReward      UserReward?    @relation(fields: [userRewardId], references: [id])
  status          OrderStatus    @default(PENDING)
  proofUrl        String?
  expiredAt       DateTime?
  gatewayRef      String? // Reference ID from payment gateway
  pointsAwarded   Boolean        @default(false)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  paymentLogs     PaymentLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
}

model PaymentLog {
  id                String           @id @default(uuid())
  orderId           String?
  order             Order?           @relation(fields: [orderId], references: [id])
  membershipOrderId String?
  membershipOrder   MembershipOrder? @relation(fields: [membershipOrderId], references: [id])
  status            String
  message           String
  payload           Json? // To store gateway webhooks or response data
  createdAt         DateTime         @default(now())
}

model PaymentMethod {
  id           String   @id @default(uuid())
  name         String
  type         String // qris, va, ewallet, manual, gateway
  status       Boolean  @default(true)
  nmid         String?
  mode         String? // static, dynamic
  qrImageUrl   String?
  provider     String?
  config       Json? // For storing VA number, QR image URL, gateway keys
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders           Order[]
  membershipOrders MembershipOrder[]
}

enum EventStatus {
  DRAFT
  LIVE
  ENDED
}

enum EventVisibility {
  PUBLIC
  PREMIUM
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PAID
  APPROVED
  REJECTED
  FAILED
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String
  name       String
  avatar     String?
  phone      String?
  role       Role       @default(USER)
  membership       Membership @default(FREE)
  membershipStatus Membership @default(FREE)
  membershipExpiredAt DateTime?
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  events  Event[] // Events created by this user
  favorites Favorite[]
  tickets Ticket[]
  orders            Order[]
  membershipOrders MembershipOrder[]
  payments          Payment[]
  notifications     Notification[]
  points            UserPoint?
  pointLogs         PointLog[]
  userRewards       UserReward[]
}

model UserReward {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rewardId  String
  reward    Reward   @relation(fields: [rewardId], references: [id])
  value     Float // The discount value or amount
  isUsed    Boolean  @default(false)
  orders    Order[]
  membershipOrders MembershipOrder[]
  createdAt DateTime @default(now())
}

model SystemConfig {
  id               String   @id @default("global")
  pointsPerOrder   Int      @default(1)
  conversionRate   Int      @default(10) // 1 point = Rp10
  isRewardsActive  Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model UserPoint {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model PointLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String // earn, redeem, expire
  points      Int
  referenceId String? // e.g. orderId or rewardId
  description String
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Reward {
  id             String      @id @default(uuid())
  title          String
  pointsRequired Int
  type           RewardType
  value          Float?
  stock          Int         @default(0)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  userRewards    UserReward[]
}

enum RewardType {
  DISCOUNT
  VOUCHER
  MERCHANDISE
  CASH
}

model Payment {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  type        PaymentType
  amount      Float
  status      PaymentStatus @default(PENDING)
  referenceId String? // ID of the Order or MembershipOrder
  createdAt   DateTime      @default(now())

  @@index([userId])
}

enum PaymentType {
  TICKET
  MEMBERSHIP
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Event {
  id          String          @id @default(uuid())
  title       String
  description String
  date        DateTime
  location    String
  latitude    Float?
  longitude   Float?
  price       Float
  capacity    Int
  image       String
  category    String
  status      EventStatus     @default(DRAFT)
  visibility  EventVisibility @default(PUBLIC)
  isFeatured  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  tickets Ticket[]
  orders  Order[]
  favorites Favorite[]
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model Ticket {
  id           String       @id @default(uuid())
  qrCode       String       @unique
  status       TicketStatus @default(ACTIVE)
  purchaseDate DateTime     @default(now())
  createdAt    DateTime     @default(now())

  userId  String
  user    User   @relation(fields: [userId], references: [id])
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  order   Order?

  @@index([userId])
  @@index([eventId])
}

model Order {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  eventId         String
  event           Event          @relation(fields: [eventId], references: [id])
  total           Float
  discountAmount  Float          @default(0)
  userRewardId    String?
  userReward      UserReward?    @relation(fields: [userRewardId], references: [id])
  status          OrderStatus    @default(PENDING)
  proofUrl        String?
  gatewayRef      String? // Reference ID from payment gateway
  pointsAwarded   Boolean        @default(false)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  paymentLogs     PaymentLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  ticketId String? @unique
  ticket   Ticket? @relation(fields: [ticketId], references: [id])

  @@index([userId])
  @@index([eventId])
}
